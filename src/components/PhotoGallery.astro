---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { folder: string }
const { folder } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/**/*.{jpg,jpeg,JPG,JPEG,png,PNG,webp}',
  { eager: true },
);
const photos = Object.entries(images)
  .filter(([path]) => path.slice(0, path.lastIndexOf('/')) === `../assets/${folder}`)
  .sort(([a], [b]) => a.localeCompare(b)).map(([path, image]) => ({
  image: image.default,
  label: path.split('/').pop()!.replace(/\.[^.]+$/, '').replace(/([a-z])([A-Z])/g, '$1 $2').replace(/(\D)(\d)/g, '$1 $2'),
}));
if (photos.length === 0) {
  throw new Error(`No gallery photos found in src/assets/${folder}. Check the photoGallery folder name.`);
}
---

<div class="photo-gallery">
  {photos.map(({ image, label }) => (
    <figure>
      <a href={image.src} aria-label={`View full photo: ${label}`}>
        <Image src={image} alt={label} widths={[400, 800, 1200]} sizes="(max-width: 640px) 90vw, (max-width: 1000px) 45vw, 30vw" format="webp" loading="lazy" />
      </a>
      <figcaption>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</figcaption>
    </figure>
  ))}
</div>

<style>
  .photo-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: clamp(1rem, 2vw, 2rem);
    align-items: start;
  }
  figure { margin: 0; min-width: 0; }
  a { display: block; border-radius: 8px; }
  a:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  img { display: block; width: 100%; height: auto; }
  figcaption { margin-top: 0.5rem; font-size: 0.85em; color: rgb(var(--gray)); }
</style>
