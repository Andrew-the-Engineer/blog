---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';

export async function getStaticPaths() {
	const posts = await getCollection('fun');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'fun'>;

const post = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} wide={Boolean(post.data.photoGallery)}>
	<Content />
	{post.data.photoGallery && <PhotoGallery folder={post.data.photoGallery} captions={post.data.photoCaptions} />}
</BlogPost>
